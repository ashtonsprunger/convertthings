{
  "name": "convert",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://convertthings.com",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "convert-units": "^2.3.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "bin": {
    "convertthings-mcp": "./bin/mcp.mjs",
    "convertthings": "./bin/cli.mjs"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/generateIcons.mjs && node scripts/generateSitemap.mjs",
    "build": "react-scripts build",
    "postbuild": "node scripts/prerender.mjs",
    "prerender": "node scripts/prerender.mjs",
    "icons": "node scripts/generateIcons.mjs",
    "sitemap": "node scripts/generateSitemap.mjs",
    "test": "react-scripts test",
    "test:api": "node scripts/test-api.mjs",
    "mcp": "node bin/mcp.mjs",
    "cli": "node bin/cli.mjs",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^4.0.0",
    "sharp": "^0.35.5"
  }
}
